# Режим конфигурации: local (разработка: предупреждения вместо ошибок,
# loopback разрешён) или production (VPS: fail-fast до старта сервисов).
# На VPS обязателен production: пустые API_ID/API_HASH/BOT_TOKEN/OWNER_ID,
# CP_JWT_SECRET и CP_BOOTSTRAP_ADMIN_PASSWORD со значениями change-me*/admin123/admin/password,
# CP_JWT_SECRET короче 32 символов и относительные sqlite-пути останавливают старт с ошибкой.
# Проверка одной командой (бота + Control Plane, секреты в выводе маскируются):
#   python -m tools.validate_config --mode local|production
COREBOT_ENV=local

# Telegram API (получить на https://my.telegram.org)
# Для команды можно использовать один общий app (API_ID/API_HASH) на всех инстансах.
# Заполните эти 2 строки один раз в приватном шаблоне и больше не меняйте при каждом деплое.
API_ID=
API_HASH=

# Control Bot Token (от @BotFather) — индивидуально для каждого инстанса
BOT_TOKEN=

# ID владельца бота (для доступа к админ-функциям) — индивидуально для каждого инстанса
OWNER_ID=

# База данных (рекомендуемый путь для VPS)
DATABASE_URL=sqlite+aiosqlite:////opt/corebot/app/data/corebot.db

# Логирование
LOG_LEVEL=INFO

# Настройки рассылок (опционально)
DEFAULT_DELAY_BETWEEN_MESSAGES=5
DEFAULT_DELAY_BETWEEN_ACCOUNTS=10
MAX_RETRIES_ON_FLOOD=3

# Parser-worker. Выберите РОВНО ОДИН режим:
#   PARSER_EMBEDDED=1 — парсер работает внутри Control Plane; отдельный процесс не запускать.
#   PARSER_EMBEDDED=0 — можно запустить: python -m workers.parser_worker
PARSER_EMBEDDED=1
PARSER_POLL_SEC=2

# ===========================================
# ПРОКСИ ДЛЯ CONTROL BOT (для обхода блокировок)
# ===========================================
# Оставьте пустым, если прокси не нужен
# Тип прокси: socks5, http, или оставьте пустым
CONTROL_BOT_PROXY_TYPE=
# CONTROL_BOT_PROXY_TYPE=socks5

# Хост и порт прокси
CONTROL_BOT_PROXY_HOST=
# CONTROL_BOT_PROXY_HOST=1.2.3.4

CONTROL_BOT_PROXY_PORT=
# CONTROL_BOT_PROXY_PORT=1080

# Авторизация прокси (если требуется)
CONTROL_BOT_PROXY_USERNAME=
CONTROL_BOT_PROXY_PASSWORD=

# ===========================================
# DISTRIBUTED AGENT TELEMETRY (local bot -> control plane)
# ===========================================
CP_AGENT_ENABLED=0
CP_INGEST_URL=http://127.0.0.1:8081/ingest/batch
CP_AGENT_TOKEN=
CP_AGENT_NAME=corebot-agent
CP_AGENT_VERSION=dev

# ===========================================
# CONTROL PLANE SERVER (central backend)
# ===========================================
CP_DATABASE_URL=sqlite:////opt/corebot/app/data/control_plane.db
# ОБЯЗАТЕЛЬНО замените перед VPS-запуском (fail-fast при COREBOT_ENV=production:
# значения change-me*/admin123/admin/password запрещены, минимум 32 символа,
# рекомендуется 64 hex — сгенерируйте командой ниже; validator показывает только
# длину/маску, никогда значения):
#   openssl rand -hex 32
# Установка должна быть остановлена, если остались change-me-please/admin.
CP_JWT_SECRET=change-me-please
CP_BOOTSTRAP_ADMIN_USERNAME=admin
# Тот же fail-fast: change-me*/admin123/admin/password запрещены, минимум 12 символов.
CP_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
CP_TELEGRAM_BOT_TOKEN=
CP_TELEGRAM_ALERT_CHAT_ID=

# Sync-URL до основной базы бота. Используется веб-панелью для чтения
# аккаунтов/диалогов и постановки ручных отправок в outbound_queue.
# По умолчанию — тот же файл, что и DATABASE_URL, но без +aiosqlite.
BOT_DATABASE_URL=sqlite:////opt/corebot/app/data/corebot.db

# SSE-стрим (опционально): период опроса БД и батч сообщений за тик.
CP_BUSINESS_STREAM_INTERVAL=1.5
CP_BUSINESS_STREAM_BATCH=200

# ===========================================
# OpenRouter / нейрочат (опционально)
# ===========================================
# Ключ можно задать здесь или в боте: Рассылка → Нейрочат → «Ключ OpenRouter»
OPENROUTER_API_KEY=
# Шифрование ключа в SQLite (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENROUTER_KEY_ENCRYPTION_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
# Глобальный toggle нейрочата (fallback, если в БД не задано): 1/true=вкл, 0/false=выкл
NEUROCHAT_ENABLED=1
DEFAULT_NEURO_MODEL=openai/gpt-oss-120b:free
NEURO_MAX_CONCURRENT=8
NEURO_OPENROUTER_MAX_RETRIES=3
NEURO_OPENROUTER_RETRY_BASE_SEC=2
NEURO_MAX_TOKENS=0
NEURO_DEFAULT_TEMPERATURE=0.7
NEURO_DEFAULT_TOP_P=0.9
NEURO_DEFAULT_TOP_K=40
NEURO_DEFAULT_FREQUENCY_PENALTY=0.0
NEURO_DEFAULT_PRESENCE_PENALTY=0.0
NEURO_DEFAULT_REPETITION_PENALTY=1.15
NEURO_DEFAULT_MIN_P=0.1
NEURO_DEFAULT_TOP_A=0.0
# Базовый UTC-сдвиг плейсхолдеров {date}/{time}/{datetime}. Пример: 3 => UTC+03:00
MAILING_BASE_UTC_OFFSET=0
