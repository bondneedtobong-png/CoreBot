# Environment and secrets
.env
.env.*
!.env.example

# Python cache/build
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
venv*/
.venv/

# Runtime data and logs
data/
logs/
*.log

# IDE / local tooling
.idea/
.vscode/
.cursor/

# OS files
.DS_Store
Thumbs.db

# Release artifacts (task 06, generated on the VPS by make_release.py,
# never committed: version source of truth is VERSION + git SHA)
RELEASE.json
.deployed_sha

# Fleet automation secrets (task 07, ADR 0001: Vault password + vault file +
# local inventory stay on the operator control node, never in Git; only
# *.example schemas are committed)
ops/ansible/inventory/hosts.yml
ops/ansible/group_vars/all/vault.yml
ops/ansible/group_vars/**/vault.yml
.vault-password-file
vault-password-file
/tmp/corebot-fleet-reports/
